{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lernapps.net/tooling/schemas/explainer.v1.schema.json",
  "title": "Content of a lernapps explainer",
  "description": "The content of an app built from the archetype explainer (runtime @lernapps/app-templates), as YAML in src/: the app (src/app.yaml), each chapter (src/<chapter>/chapter.yaml), each page (src/<chapter>/<page>.yaml) and data files (src/data/<name>.yaml). A page is a list of blocks from a closed set; structure comes only from section blocks. The build validates every file against this schema, then what a schema cannot say (order lists complete, depth, languages complete, formulas in the command list), and fails with one line per problem. Every text is for learners, in plain language. A text is a string while German is the app's only language, else a map of texts by language: { de: …, en: … }.",
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["chapters"],
        "properties": {
          "chapters": {}
        }
      },
      "then": {
        "$ref": "#/$defs/app"
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["pages"],
        "properties": {
          "pages": {}
        }
      },
      "then": {
        "$ref": "#/$defs/chapter"
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["blocks"],
        "properties": {
          "blocks": {}
        }
      },
      "then": {
        "$ref": "#/$defs/page"
      }
    },
    {
      "if": {
        "type": "array"
      },
      "then": {
        "$ref": "#/$defs/data"
      }
    }
  ],
  "$defs": {
    "id": {
      "description": "A stable name, part of the address: lower-case letters, digits and hyphens. Keep it once published, so that links to it keep working.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": {
      "description": "A text without formatting: a string while German is the only language of the app, else a map of texts by language ({ de: …, en: … }) with every declared language.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z]{2}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      ]
    },
    "markdown": {
      "description": "Restricted Markdown, as a text or a map of texts by language: paragraphs, **bold**, *italics*, lists, links and line breaks, formulas as $…$ in the formula command list. No headings (use a section block), no HTML, no images (use a figure block), no code (use a code block), no quotes (use a quote block), no tables (use a table block). A link to a page of the app starts with / and names it from the app's root: /<chapter>/<page>/#<section>.",
      "$ref": "#/$defs/text"
    },
    "latex": {
      "description": "One formula in the LaTeX subset of the formula command list: \\frac, \\cdot, \\times, \\div, \\%, \\text, ^, _, \\sqrt, \\approx, \\pm, \\le, \\ge, \\neq, \\, (thin space), parentheses and braces; \\ce{…} for chemical equations and \\pu{…} for units (mhchem). Written without the $ signs. A map by language only when it has \\text{…} that differs by language.",
      "$ref": "#/$defs/text"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "description": "What the source is, e.g. the title of the article or book.",
          "$ref": "#/$defs/text"
        },
        "url": {
          "description": "Where to read it.",
          "type": "string",
          "pattern": "^https?://\\S+$"
        }
      }
    },
    "credit": {
      "description": "Where a bundled image or a quote comes from: the source (a URL or a citation) and its licence (an SPDX identifier such as CC-BY-SA-4.0, or \"gemeinfrei\").",
      "type": "object",
      "properties": {
        "source": {
          "description": "Where it comes from: a URL or a citation.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "licence": {
          "description": "Its licence: an SPDX identifier (CC-BY-SA-4.0, CC0-1.0, …), or gemeinfrei for a work in the public domain.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "image": {
      "description": "A bundled image file in src/images/, as a path from src/: images/<name>.svg (or .png, .jpg, .webp).",
      "type": "string",
      "pattern": "^images/[a-z0-9]+(-[a-z0-9]+)*\\.(svg|png|jpg|webp)$"
    },
    "app": {
      "description": "src/app.yaml: the app, its languages and the order of its chapters.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "intro", "languages", "chapters"],
      "properties": {
        "title": {
          "description": "The app's title: the start page's h1 and the title of every page.",
          "$ref": "#/$defs/text"
        },
        "intro": {
          "description": "What the app explains and for whom, under the title of the start page.",
          "$ref": "#/$defs/markdown"
        },
        "languages": {
          "description": "The languages of the app, German first. Every text is then complete in each of them; each language other than German gets its own page tree below /<language>/.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "chapters": {
          "description": "The order of the chapters: the id of each folder src/<chapter>/, each exactly once. An app with one chapter hides it in the navigation and keeps it in the address.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "sources": {
          "description": "Where the app's facts come from, listed on the start page.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "chapter": {
      "description": "src/<chapter>/chapter.yaml: a chapter and the order of its pages.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "pages"],
      "properties": {
        "title": {
          "description": "The chapter's title.",
          "$ref": "#/$defs/text"
        },
        "summary": {
          "description": "What the chapter is about, on the chapter's page and in the contents.",
          "$ref": "#/$defs/markdown"
        },
        "pages": {
          "description": "The order of the pages: the id of each file src/<chapter>/<page>.yaml, each exactly once.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "page": {
      "description": "src/<chapter>/<page>.yaml: a page, its address /<chapter>/<page>/. Its blocks in order; structure by section blocks (h2), with at most one level of sections inside them (h3). Exercises come as blocks in the next version of this schema; a page will then need one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "blocks"],
      "properties": {
        "title": {
          "description": "The page's title: its h1.",
          "$ref": "#/$defs/text"
        },
        "description": {
          "description": "One sentence on what the page explains, for search engines and llms.txt.",
          "$ref": "#/$defs/text"
        },
        "blocks": {
          "$ref": "#/$defs/blocks"
        }
      }
    },
    "data": {
      "description": "src/data/<name>.yaml: a list of records with the same fields, e.g. events with date, title and text. Blocks draw from it by its name (a timeline's data).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "description": "The kind of block.",
          "enum": [
            "text",
            "formula",
            "figure",
            "labelled-figure",
            "table",
            "timeline",
            "definition",
            "quote",
            "code",
            "example",
            "note",
            "section"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/textBlock"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "formula"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/formula"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "figure"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/figure"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "labelled-figure"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/labelledFigure"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/table"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "timeline"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/timeline"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "definition"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/definition"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "quote"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/quote"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/code"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "example"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/box"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "note"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/box"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "section"
              }
            },
            "required": ["type"],
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/section"
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "textBlock": {
      "description": "Prose in restricted Markdown.",
      "required": ["text"],
      "properties": {
        "text": {
          "$ref": "#/$defs/markdown"
        }
      },
      "type": "object"
    },
    "formula": {
      "description": "One formula on its own line, rendered at build to MathML.",
      "required": ["formula"],
      "properties": {
        "formula": {
          "$ref": "#/$defs/latex"
        }
      },
      "type": "object"
    },
    "figure": {
      "description": "A figure: drawn from data (draw) or a bundled image (image, with its source and licence), one of the two. It has an alternative text that says what it shows, and a caption that says what to see.",
      "required": ["alt", "caption"],
      "allOf": [
        {
          "$ref": "#/$defs/credit"
        }
      ],
      "properties": {
        "draw": {
          "$ref": "#/$defs/drawing"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "alt": {
          "description": "What the figure shows, for those who cannot see it.",
          "$ref": "#/$defs/text"
        },
        "caption": {
          "description": "What to see in the figure, under it.",
          "$ref": "#/$defs/markdown"
        }
      },
      "dependentRequired": {
        "image": ["source", "licence"]
      },
      "type": "object"
    },
    "drawing": {
      "description": "A figure drawn from numbers at build, as inline SVG: hundred-grid (a field of 100 squares, filled of them shaded) or bar (a strip, part of whole shaded, with its percentage).",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["hundred-grid", "bar"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hundred-grid"
              }
            },
            "required": ["kind"],
            "type": "object"
          },
          "then": {
            "required": ["filled"],
            "properties": {
              "filled": {
                "description": "How many of the 100 squares are shaded.",
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bar"
              }
            },
            "required": ["kind"],
            "type": "object"
          },
          "then": {
            "required": ["part", "whole"],
            "properties": {
              "part": {
                "description": "The shaded part.",
                "type": "number",
                "minimum": 0
              },
              "whole": {
                "description": "The whole strip, 100 %.",
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "type": "object"
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "labelledFigure": {
      "description": "A bundled image with numbered labels at positions and a legend of the labels in order.",
      "required": ["image", "alt", "labels", "source", "licence"],
      "allOf": [
        {
          "$ref": "#/$defs/credit"
        }
      ],
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "alt": {
          "description": "What the image shows, for those who cannot see it.",
          "$ref": "#/$defs/text"
        },
        "caption": {
          "description": "What to see in the figure.",
          "$ref": "#/$defs/markdown"
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "text"],
            "properties": {
              "x": {
                "description": "From the left edge, in percent of the width.",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "description": "From the top edge, in percent of the height.",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "text": {
                "description": "What the label names.",
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      },
      "type": "object"
    },
    "table": {
      "description": "A table with a caption. Cells are restricted Markdown without paragraphs.",
      "required": ["caption", "rows"],
      "properties": {
        "caption": {
          "description": "What the table shows.",
          "$ref": "#/$defs/text"
        },
        "header": {
          "description": "The header row: one heading per column.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/markdown"
          }
        },
        "rowHeaders": {
          "description": "The first cell of each row heads the row.",
          "type": "boolean",
          "default": false
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/markdown"
            }
          }
        }
      },
      "type": "object"
    },
    "timeline": {
      "description": "Dated events, from the earliest: listed here (events) or the records of a data file (data) with the fields date, title and optional label and text; one of the two.",
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "data": {
          "description": "The name of a data file src/data/<name>.yaml.",
          "$ref": "#/$defs/id"
        }
      },
      "type": "object"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "title"],
      "properties": {
        "date": {
          "description": "The date: a year (1789; -44 for 44 BC), a month (1789-07) or a day (1789-07-14).",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^-?\\d{1,4}(-\\d{2}(-\\d{2})?)?$"
            }
          ]
        },
        "label": {
          "description": "The date as the learner reads it, when it differs from the date itself, e.g. um 1500.",
          "$ref": "#/$defs/text"
        },
        "title": {
          "description": "What happened, in a few words.",
          "$ref": "#/$defs/text"
        },
        "text": {
          "description": "More on it.",
          "$ref": "#/$defs/markdown"
        }
      }
    },
    "definition": {
      "description": "A term and what it means, in place; collected into the app's glossary page, which every term links to.",
      "required": ["term", "explanation"],
      "properties": {
        "term": {
          "description": "The term.",
          "$ref": "#/$defs/text"
        },
        "explanation": {
          "description": "What it means.",
          "$ref": "#/$defs/markdown"
        }
      },
      "type": "object"
    },
    "quote": {
      "description": "A quotation, quoted exactly, with its origin, source and licence.",
      "required": ["text", "origin", "source", "licence"],
      "allOf": [
        {
          "$ref": "#/$defs/credit"
        }
      ],
      "properties": {
        "text": {
          "description": "The quotation itself, exactly as written.",
          "$ref": "#/$defs/markdown"
        },
        "origin": {
          "description": "Who said or wrote it, where and when.",
          "type": "object",
          "additionalProperties": false,
          "required": ["author"],
          "properties": {
            "author": {
              "description": "Who said or wrote it. A name is the same in every language: a string, or a map by language where it differs.",
              "$ref": "#/$defs/text"
            },
            "work": {
              "description": "Where it was said or written: the work, as it is called; a string, or a map by language where its title is translated.",
              "$ref": "#/$defs/text"
            },
            "year": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/text"
                }
              ],
              "description": "When: a year, or a text such as um 500 v. Chr."
            }
          }
        }
      },
      "type": "object"
    },
    "code": {
      "description": "Program code, highlighted at build.",
      "required": ["language", "code"],
      "properties": {
        "language": {
          "enum": ["bash", "c", "css", "html", "java", "javascript", "json", "plaintext", "python", "sql", "typescript"]
        },
        "code": {
          "description": "The code, as it is.",
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "description": "What the code does.",
          "$ref": "#/$defs/text"
        }
      },
      "type": "object"
    },
    "box": {
      "description": "A box with a heading (the next level below its place) and blocks: example for a worked example, note for a hint or something to remember. A box holds no sections and no boxes.",
      "required": ["title", "blocks"],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "blocks": {
          "$ref": "#/$defs/blocks"
        }
      },
      "type": "object"
    },
    "section": {
      "description": "A section: a heading (h2, or h3 inside a section) and its blocks. Its address is #<id>, inside a section #<section>/<id>.",
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "blocks": {
          "$ref": "#/$defs/blocks"
        }
      },
      "type": "object"
    }
  }
}
