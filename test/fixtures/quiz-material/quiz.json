  "questions": [
    {
      "id": "ring",
      "type": "single-choice",
      "text": {
        "de": "Welche Form zeigt das Bild?",
        "en": "Which shape does the picture show?"
      },
      "material": [
        {
          "type": "figure",
          "image": "images/kreis.svg",
          "alt": {
            "de": "Ein blauer Kreis mit einem weißen Kreis in der Mitte",
            "en": "A blue circle with a white circle in the middle"
          },
          "caption": {
            "de": "Zwei Kreise mit demselben Mittelpunkt.",
            "en": "Two circles with the same centre."
          },
          "source": {
            "de": "eigene Zeichnung",
            "en": "own drawing"
          },
          "licence": "CC0-1.0"
        }
      ],
      "options": [
        {
          "text": {
            "de": "Ein Ring",
            "en": "A ring"
          },
          "correct": true,
          "info": {
            "de": "Ein Ring liegt zwischen zwei Kreisen mit demselben Mittelpunkt.",
            "en": "A ring lies between two circles with the same centre."
          }
        },
        {
          "text": {
            "de": "Eine Ellipse",
            "en": "An ellipse"
          },
          "correct": false,
          "info": {
            "de": "Eine Ellipse hat zwei Brennpunkte statt eines Mittelpunkts für beide Ränder.",
            "en": "An ellipse has two foci rather than one centre for both edges."
          }
        },
        {
          "text": {
            "de": "Ein Quadrat",
            "en": "A square"
          },
          "correct": false,
          "info": {
            "de": "Ein Quadrat hat vier gleich lange gerade Seiten.",
            "en": "A square has four straight sides of equal length."
          }
        }
      ],
      "explanation": {
        "de": "Die weiße Fläche in der Mitte macht aus der Kreisscheibe einen Ring.",
        "en": "The white area in the middle makes the disc a ring."
      },
      "links": [
        {
          "title": {
