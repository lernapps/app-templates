        "en": "Layer 2 lies between layers 1 and 3."
      },
      "material": [
        {
          "type": "text",
          "text": {
            "de": "Das Bild zeigt drei **Schichten** von unten nach oben.",
            "en": "The picture shows three **layers** from bottom to top."
