            {
              "x": 50,
              "y": 58,
              "text": {
                "de": "Mittlere Schicht",
                "en": "Middle layer"
              }
            },
            {
              "x": 50,
              "y": 30,
              "text": {
                "de": "Obere Schicht",
                "en": "Upper layer"
              }
            }
          ],
          "source": {
            "de": "eigene Zeichnung",
            "en": "own drawing"
          },
          "licence": "CC0-1.0"
        }
      ],
      "answer": true,
      "explanation": {
        "de": "Die Nummern gehen von unten nach oben; Schicht 2 ist die mittlere.",
        "en": "The numbers go from bottom to top; layer 2 is the middle one."
      },
      "links": [
