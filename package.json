{
  "name": "@lernapps/app-templates",
  "version": "0.0.0",
  "description": "The templates of the archetypes of lernapps.net apps, and the runtime of each archetype that apps depend on (the quiz: engine, build step, styles, end-to-end tests, the schema of the question bank, and each question on its own for other archetypes; the explainer: build step, client module with its exercises, the islands of its Vue components, styles, end-to-end tests, the schema of its content; the interactive archetype: build step, the start page and the app page around the app's own Vue components and core, its playthroughs, styles, end-to-end tests, the schemas of its start page and its playthroughs)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lernapps/app-templates.git"
  },
  "files": [
    "dist",
    "runtime"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./quiz": {
      "types": "./runtime/quiz/engine.ts",
      "default": "./dist/quiz.mjs"
    },
    "./quiz/plugin": {
      "types": "./runtime/quiz/plugin.ts",
      "default": "./dist/quiz-plugin.mjs"
    },
    "./quiz/question": {
      "types": "./runtime/quiz/question.ts",
      "default": "./dist/quiz-question.mjs"
    },
    "./quiz/e2e": {
      "types": "./runtime/quiz/e2e.ts",
      "default": "./dist/quiz-e2e.mjs"
    },
    "./quiz/style.css": "./runtime/quiz/quiz.css",
    "./quiz/quiz.v1.schema.json": "./runtime/quiz/quiz.v1.schema.json",
    "./quiz/messages/de.json": "./runtime/quiz/messages/de.json",
    "./quiz/messages/en.json": "./runtime/quiz/messages/en.json",
    "./explainer": {
      "types": "./runtime/explainer/explainer.ts",
      "default": "./dist/explainer.mjs"
    },
    "./explainer/plugin": {
      "types": "./runtime/explainer/plugin.ts",
      "default": "./dist/explainer-plugin.mjs"
    },
    "./explainer/e2e": {
      "types": "./runtime/explainer/e2e.ts",
      "default": "./dist/explainer-e2e.mjs"
    },
    "./explainer/style.css": "./runtime/explainer/explainer.css",
    "./explainer/messages/de.json": "./runtime/explainer/messages/de.json",
    "./explainer/messages/en.json": "./runtime/explainer/messages/en.json",
    "./explainer/explainer.v1.schema.json": "./runtime/explainer/explainer.v1.schema.json",
    "./interactive": {
      "types": "./runtime/interactive/interactive.ts",
      "default": "./dist/interactive.mjs"
    },
    "./interactive/plugin": {
      "types": "./runtime/interactive/plugin.ts",
      "default": "./dist/interactive-plugin.mjs"
    },
    "./interactive/e2e": {
      "types": "./runtime/interactive/e2e.ts",
      "default": "./dist/interactive-e2e.mjs"
    },
    "./interactive/style.css": "./runtime/interactive/interactive.css",
    "./interactive/messages/de.json": "./runtime/interactive/messages/de.json",
    "./interactive/messages/en.json": "./runtime/interactive/messages/en.json",
    "./interactive/interactive.v1.schema.json": "./runtime/interactive/interactive.v1.schema.json",
    "./interactive/playthrough.v1.schema.json": "./runtime/interactive/playthrough.v1.schema.json"
  },
  "scripts": {
    "prepare": "vp pack && vp config --no-agent",
    "test": "vp test",
    "check:vue": "vue-tsc --noEmit -p tsconfig.vue.json"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "ajv": "8.20.0",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "source-map-js": "1.2.2",
    "temml": "0.14.0",
    "vue": "3.5.44",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@doctc/arc42": "0.36.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite-plus": "1.0.0",
    "vue-tsc": "3.3.13"
  },
  "peerDependencies": {
    "@lernapps/tooling": "*",
    "playwright": "*",
    "vite-plus": "1.0.0"
  },
  "peerDependenciesMeta": {
    "@lernapps/tooling": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "lernapps": {
    "changes": {
      "kind": "app"
    }
  }
}
